#!/bin/sh

has_service() {
    dbus-send --session --print-reply \
        --dest=org.freedesktop.DBus \
        /org/freedesktop/DBus \
        org.freedesktop.DBus.NameHasOwner \
        string:com.feralinteractive.GameMode 2>/dev/null | grep -q 'boolean true'
}

if ! has_service; then
    gamemoded -d >"${XDG_RUNTIME_DIR:-/tmp}/cpak-gamemode.log" 2>&1 &
    attempts=0
    while ! has_service && [ "$attempts" -lt 20 ]; do
        sleep 0.05
        attempts=$((attempts + 1))
    done
fi

exec /usr/games/gamemoderun "$@"
